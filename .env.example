# Neon PostgreSQL connection string (source of truth database)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign Payload's auth tokens — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public URL this app is served from (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# S3-compatible object storage (AWS S3 or Cloudflare R2) for media uploads.
# Leave these blank during local development to fall back to local disk storage.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to "true" for most S3-compatible providers (e.g. Cloudflare R2, MinIO).
# Leave unset/"false" for standard AWS S3.
S3_FORCE_PATH_STYLE=false

# Upstash Redis — caches sports-API responses and tracks daily request quota.
# Leave blank to run without caching (falls back to live fetches every time).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# api-sports.io API key (covers both Football/API-Football and the NFL/American
# Football API — same account, same key, different host per sport). Required
# once the football/NFL sync adapters are wired in; leave blank until then.
# If you signed up via RapidAPI instead of api-sports.io's own dashboard, say
# so — the client uses different headers/hosts for that path.
SPORTS_API_KEY=

# Shared secret required (as `Authorization: Bearer <value>`) to call
# POST /api/sync — this endpoint spends real api-sports.io quota, so it must
# never be publicly callable. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_TRIGGER_SECRET=

# Resend (resend.com) — powers both Payload's own system emails and the
# contact-form notification (src/app/api/contact/route.ts). Leave blank to
# boot without email (Payload logs "No email adapter provided" and the
# contact form still saves submissions — it just can't notify by email).
RESEND_API_KEY=
# Must be on a domain verified in your Resend account for real delivery.
# Leave blank to send from Resend's shared test address (onboarding@resend.dev),
# which only delivers to the email your Resend account itself is signed up
# with — fine for local testing, not for production.
RESEND_FROM_EMAIL=
